@base = http://localhost:5000

# ═══════════════════════════════════════════════
# SMARTAGRO API — TEST ALL 12 ENDPOINTS
# VS Code REST Client Extension Required
# Run in order: 1 → 12
# ═══════════════════════════════════════════════


### ── 1. HEALTH CHECK ──────────────────────────
# Expected: 200 OK | "SmartAgro API is running."

GET {{base}}/api/health
Content-Type: application/json


### ── 2. SAVE ORCHARD PROFILE ──────────────────
# Expected: 201 Created | "Profile saved successfully."

POST {{base}}/api/profile
Content-Type: application/json

{
    "farmer_name":      "Jibran Ayub",
    "location":         "Srinagar, Kashmir",
    "lat":              34.0837,
    "lon":              74.7973,
    "crop_type":        "Apple",
    "growth_stage":     "Fruit Set",
    "last_spray_date":  "2026-04-28",
    "min_interval_days": 14,
    "preferred_time":   "6 AM - 9 AM"
}


### ── 3. GET ORCHARD PROFILE ───────────────────
# Expected: 200 OK | farmer profile object

GET {{base}}/api/profile
Content-Type: application/json


### ── 4. SPRAY DECISION (CORE) ─────────────────
# Expected: 200 OK | decision: SPRAY / DELAY / SKIP
# Uses LIVE weather from OpenWeatherMap + ML model

GET {{base}}/api/decision?mode=tomorrow
Content-Type: application/json


### ── 5. LIVE WEATHER ──────────────────────────
# Expected: 200 OK | current + forecast + safety flags

GET {{base}}/api/weather
Content-Type: application/json


### ── 6. SKUAST-K SCHEDULE (current year) ──────
# Expected: 200 OK | 16 spray stages with PAST/TODAY/UPCOMING

GET {{base}}/api/schedule
Content-Type: application/json


### ── 7. SKUAST-K SCHEDULE (specific year) ─────
# Expected: 200 OK | same 16 stages for 2027

GET {{base}}/api/schedule?year=2027
Content-Type: application/json


### ── 8. YEARLY CALENDAR ───────────────────────
# Expected: 200 OK | 20 interval-based spray dates

GET {{base}}/api/calendar
Content-Type: application/json


### ── 9. LOG A SPRAY (status: DONE) ───────────
# Expected: 201 Created | "Spray log saved successfully."

POST {{base}}/api/log
Content-Type: application/json

{
    "date":             "2026-05-12",
    "spray_name":       "Zineb + Hexaconazole 72% WP",
    "dosage":           "125 g / 100 L water",
    "growth_stage":     "Fruit Set",
    "status":           "DONE",
    "notes":            "Sprayed at 7 AM, weather clear",
    "temp_at_spray":    19.0,
    "humidity_at_spray": 55.0,
    "wind_at_spray":    8.0
}


### ── 10. LOG A SPRAY (status: POSTPONED) ──────
# Expected: 201 Created | "Spray log saved successfully."

POST {{base}}/api/log
Content-Type: application/json

{
    "date":             "2026-05-10",
    "spray_name":       "Captan 50% WP",
    "dosage":           "300 g / 100 L water",
    "growth_stage":     "Fruitlet",
    "status":           "POSTPONED",
    "notes":            "Heavy rain in morning, postponed to next day",
    "temp_at_spray":    14.0,
    "humidity_at_spray": 85.0,
    "wind_at_spray":    12.0
}


### ── 11. LOG A SPRAY (status: SKIPPED) ────────
# Expected: 201 Created | "Spray log saved successfully."

POST {{base}}/api/log
Content-Type: application/json

{
    "date":             "2026-05-05",
    "spray_name":       "Mancozeb 75% WP",
    "dosage":           "300 g / 100 L water",
    "growth_stage":     "Petal Fall",
    "status":           "SKIPPED",
    "notes":            "Interval not completed yet",
    "temp_at_spray":    0.0,
    "humidity_at_spray": 0.0,
    "wind_at_spray":    0.0
}


### ── 12. SPRAY HISTORY ────────────────────────
# Expected: 200 OK | list of all 3 logs just saved

GET {{base}}/api/history
Content-Type: application/json


### ── 13. DELETE SPRAY LOG ─────────────────────
# Expected: 200 OK | "Log entry 1 deleted."
# Change ID to match an actual log ID from history

DELETE {{base}}/api/log/8
Content-Type: application/json


### ── 14. MONTHLY REPORT (current month) ───────
# Expected: 200 OK | done/postponed/skipped counts + compliance %

GET {{base}}/api/report?year=2026&month=5
Content-Type: application/json


### ── 15. MONTHLY REPORT (previous month) ──────
# Expected: 200 OK | empty report (no logs for April yet)

GET {{base}}/api/report?year=2026&month=4
Content-Type: application/json


### ── 16. ALL SPRAY STAGES ─────────────────────
# Expected: 200 OK | 16 SKUAST-K stages from database

GET {{base}}/api/spray-stages
Content-Type: application/json


### ── 17. INVALID STATUS TEST ──────────────────
# Expected: 400 Bad Request | "Invalid status..."

POST {{base}}/api/log
Content-Type: application/json

{
    "date":         "2026-05-12",
    "spray_name":   "Test Spray",
    "growth_stage": "Fruit Set",
    "status":       "INVALID_STATUS"
}


### ── 18. MISSING FIELD TEST ───────────────────
# Expected: 400 Bad Request | "Missing required field: farmer_name"

POST {{base}}/api/profile
Content-Type: application/json

{
    "location":        "Srinagar",
    "growth_stage":    "Fruit Set",
    "last_spray_date": "2026-04-28"
}


### ── 19. INVALID MONTH TEST ───────────────────
# Expected: 400 Bad Request | "Month must be between 1 and 12."

GET {{base}}/api/report?year=2026&month=15
Content-Type: application/json


### ── 20. PROFILE NOT FOUND TEST ───────────────
# To test this: manually delete data/smartagro.db
# then hit this endpoint before saving any profile
# Expected: 404 Not Found | "No profile found."

GET {{base}}/api/profile
Content-Type: application/json